; Engine configuration file.
; Hollowgate - 2.5D pixel art action RPG / survival.

config_version=5

[application]

config/name="Hollowgate"
config/description="2.5D pixel-art action RPG / survival with hidden dungeons, a dungeon editor, NPC adventurers and a guild Dungeon Hall."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

GameData="*res://src/autoload/game_data.gd"
Art="*res://src/autoload/art.gd"
Settings="*res://src/autoload/settings.gd"
Sfx="*res://src/autoload/sfx.gd"
Game="*res://src/autoload/game.gd"
DebugMode="*res://src/autoload/debug_mode.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true
timers/tooltip_delay_sec=0.2

[layer_names]

2d_physics/layer_1="walls"
2d_physics/layer_2="low_obstacles"
2d_physics/layer_3="player"
2d_physics/layer_4="enemies"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.043, 0.039, 0.07, 1)
